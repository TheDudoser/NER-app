{% extends "base.html.jinja" %}

{% block head %}
    {{ super() }}
    <link href="/public/css/search.css" rel="stylesheet">
    <style>
        .connection-type {
            font-weight: bold;
            color: #6c757d;
            margin-bottom: 5px;
        }

        .connection-list {
            margin-left: 20px;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card search-card">
                    <div class="card-body">
                        <div>
                            <h4 class="card-title mb-3"
                                style="display: flex; align-items: center;"
                            >
                                🔍 Поиск в словарях
                                <a class="btn text-decoration-none" data-bs-toggle="collapse"
                                   data-bs-target="#collapseExample" aria-expanded="false"
                                   aria-controls="collapseExample">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                         class="bi bi-info-circle" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"></path>
                                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"></path>
                                    </svg>
                                </a>
                            </h4>
                            <div class="collapse" id="collapseExample">
                                <div class="alert alert-info mb-3 d-flex align-items-center">
                                    Поиск ищет подходящие термины из 3х последних загруженных словарей и находит
                                    3 самых релевантных предложения, где встречались найденные термины
                                </div>
                            </div>
                        </div>

                        <form action="/search" method="get">
                            <div class="mb-3">
                                <label for="searchQuery">Основное словосочетание*</label>
                                <input type="text" id="searchQuery" name="query" class="form-control"
                                       placeholder="Введите слово или фразу для поиска"
                                       value="{{ request.query_params.get('query', '') }}"
                                >
                            </div>
                            <div class="mb-3">
                                <label for="searchQuery">Вспомогательное словосочетание</label>
                                <input type="text" id="searchQuery" name="additional_query" class="form-control"
                                       placeholder="Введите слово или фразу для поиска"
                                       value="{{ request.query_params.get('additional_query', '') }}"
                                >
                                <div id="emailHelp" class="form-text">Если хотите найти где встречаются сразу 2
                                    словосочетания и их пересечения в предложении
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary search-btn w-100">
                                Найти
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Блок результатов -->
    {% import 'components/term_search_result.html.jinja' as term_search_result %}
    {% import 'components/intersection_search_result.html.jinja' as intersection_search_result %}
    {% if search_results %}
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h4 class="mb-3">Результаты поиска</h4>

                {% for dict_entry in search_results %}
                    <div class="card result-card mb-4">
                        <div class="card-body">
                            <h4 class="text-primary mb-3">
                                Словарь "{{ dict_entry.dictionary.name }}"
                            </h4>

                            {% if dict_entry.terms %}
                                {% for term_entry in dict_entry.terms %}
                                    {% if term_entry.sentences %}
                                        {{ term_search_result.get(term_entry=term_entry) }}
                                    {% endif %}
                                {% endfor %}
                            {% elif dict_entry.intersection and dict_entry.intersection %}
                                {{ intersection_search_result.get(intersection=dict_entry.intersection) }}
                            {% else %}
                                <div class="alert alert-info">Ничего не найдено</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Ничего не найдено</div>
    {% endif %}
{% endblock %}

{% block javascript %}
    {{ super() }}
{% endblock %}